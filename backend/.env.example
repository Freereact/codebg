# === Server ===
PORT=8787
ALLOWED_ORIGINS=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/codebg?sslmode=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true  # Set to 'false' for self-signed certs (e.g. DigitalOcean Managed)

# === Auth ===
JWT_SECRET=replace-me-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
MAGIC_LINK_EXPIRY_MINUTES=15

# === Email (Resend) ===
RESEND_API_KEY=replace-me
MAIL_FROM=YourApp <noreply@yourdomain.com>
MAIL_TO=admin@yourdomain.com

# === CAPTCHA (Cloudflare Turnstile) ===
TURNSTILE_SECRET_KEY=replace-me

# === Build Pipeline ===
PROJECTS_DIR=/var/www/projects
SITES_DIR=/var/www/sites
SAMPLE_APPS_DIR=/path/to/sample-apps
BUILD_RATE_LIMIT_SECONDS=300

# === GitHub App (optional — for auto repo creation + webhook rebuilds) ===
GH_APP_ID=
GH_APP_PRIVATE_KEY=                  # Base64-encoded PEM private key
GH_APP_INSTALLATION_ID=
GH_WEBHOOK_SECRET=
GH_ORG=                             # GitHub org name for repo creation

# === Legacy Email Queue (optional — falls back to direct send without these) ===
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_QUEUE=email_jobs
MAX_EMAILS_PER_DAY=100
